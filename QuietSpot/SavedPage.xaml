<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuietSpot.SavedPage"
             Title="Saved Spots">

    <Grid Padding="15" RowSpacing="8" RowDefinitions="Auto,*">

        <Label Grid.Row="0" Text="Saved Spots" FontSize="26" FontAttributes="Bold" TextColor="#009B6B" />

        <CollectionView Grid.Row="1" x:Name="savedList">
            <CollectionView.EmptyView>
                <Label Text="No saved spots yet. Open a spot and tap Save." TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,5" Stroke="#009B6B" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                            <Image Grid.Column="0" Source="{Binding ImageName}" WidthRequest="170" HeightRequest="96"
                                   Aspect="AspectFill" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding RatingText}" TextColor="#F4B400" />
                                <Label Text="{Binding Location}" />
                                <Label Text="{Binding OpeningHours, StringFormat='Hours: {0}'}" />
                                <Label Text="{Binding NoiseLevel, StringFormat='Noise: {0}'}" />
                                <Label Text="{Binding Availability, StringFormat='Availability: {0}'}" />
                                <Button Text="View Details" BackgroundColor="#009B6B" TextColor="White"
                                        HorizontalOptions="Start" WidthRequest="160" Clicked="OnViewDetailsClicked" />
                                <Button Text="Remove" BackgroundColor="Red" TextColor="White"
                                        HorizontalOptions="Start" WidthRequest="160" Clicked="OnRemoveClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
