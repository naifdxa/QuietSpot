<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuietSpot.RegisterPage"
             Title="Create Account"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" MaximumWidthRequest="420">

            <Label Text="Create your account" FontSize="26" FontAttributes="Bold" TextColor="#009B6B" />

            <Label Text="Full name" FontAttributes="Bold" />
            <Entry x:Name="fullNameEntry" Placeholder="Example: Naif Alhaddar" />

            <Label Text="Username" FontAttributes="Bold" />
            <Entry x:Name="usernameEntry" Placeholder="At least 3 letters, no spaces" />

            <Label Text="Password" FontAttributes="Bold" />
            <Entry x:Name="passwordEntry" Placeholder="At least 4 characters" IsPassword="True" />

            <Label Text="Confirm password" FontAttributes="Bold" />
            <Entry x:Name="confirmEntry" Placeholder="Write the password again" IsPassword="True" Completed="OnCreateClicked" />

            <Label x:Name="errorLabel" TextColor="Red" IsVisible="False" />

            <Button Text="Create Account" BackgroundColor="#009B6B" TextColor="White" Clicked="OnCreateClicked" />
            <Button Text="Back to Login" BackgroundColor="Transparent" TextColor="#009B6B"
                    BorderColor="#009B6B" BorderWidth="2" Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
